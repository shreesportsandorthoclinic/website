{
  "name": "shreesports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:reset": "tsx scripts/seed-db.ts --reset",
    "telegram:chat-id": "tsx scripts/telegram-chat-id.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "next": "16.3.4",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "wrangler": "^4.129.1"
  }
}
